<Project>
  <!-- Repo-wide overrides applied to every project. -->
  <ItemGroup>
    <!-- Override the vulnerable transitive System.Security.Cryptography.Xml
         (8.0.2 — advisory GHSA-w3x6-4m5h-cxqf / NU1903) pulled in by
         Microsoft.PowerPlatform.Dataverse.Client. Pinned to a patched
         .NET 10 build so every project resolves the fixed version.
         10.0.9 itself was later flagged (CVE-2026-47302/-47304/-50525/
         -50527/-50648, fixed in 10.0.10); keep this on the latest 10.0.x
         patch whenever NU1903 reappears. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>
</Project>
